{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"$assets/*": ["./src/app/assets/*"],
			"$components/*": ["./src/app/components/*"],
			"$layouts/*": ["./src/app/layouts/*"],
			"$library/*": ["./src/app/library/*"],
			"$hooks/*": ["./src/app/hooks/*"],
			"$fixtures/*": ["./test/fixtures/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
		".next-e2e-ash/types/**/*.ts",
		".next-e2e-ash/dev/types/**/*.ts",
		".next-e2e-oum/types/**/*.ts",
		".next-e2e-oum/dev/types/**/*.ts",
		".next-e2e-prm/types/**/*.ts",
		".next-e2e-prm/dev/types/**/*.ts",
		".next-e2e-hsm/types/**/*.ts",
		".next-e2e-hsm/dev/types/**/*.ts",
		".next-preview-prm/types/**/*.ts",
		".next-preview-prm/dev/types/**/*.ts",
		".next-preview-ash/types/**/*.ts",
		".next-preview-ash/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
