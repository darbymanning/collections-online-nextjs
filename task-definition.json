{
	"family": "odp",
	"containerDefinitions": [
		{
			"name": "odp",
			"image": "<IMAGE>",
			"cpu": 0,
			"links": [],
			"portMappings": [
				{
					"containerPort": 3000,
					"hostPort": 3000,
					"protocol": "tcp"
				}
			],
			"essential": true,
			"healthCheck": {
				"command": ["CMD-SHELL", "curl -f http://$(hostname):3000/healthcheck || exit 1"],
				"interval": 30,
				"timeout": 5,
				"retries": 3,
				"startPeriod": 15
			},
			"entryPoint": [],
			"command": [],
			"environment": [],
			"environmentFiles": [],
			"mountPoints": [],
			"volumesFrom": [],
			"secrets": [],
			"dnsServers": [],
			"dnsSearchDomains": [],
			"extraHosts": [],
			"dockerSecurityOptions": [],
			"dockerLabels": {},
			"ulimits": [],
			"systemControls": [],
			"credentialSpecs": []
		}
	],
	"executionRoleArn": "arn:aws:iam::322692172920:role/ecsTaskExecutionRole",
	"networkMode": "awsvpc",
	"volumes": [],
	"placementConstraints": [],
	"requiresCompatibilities": ["FARGATE"],
	"cpu": "256",
	"memory": "512"
}
