# Env schema for collections-online, validated at boot by varlock — https://varlock.dev
# Set the actual value in `.env.local` (gitignored), e.g. `NEXT_PUBLIC_MUSEUM=hsm`
# ---

# Active GLAM Oxford museum site for this deployment:
# - `ash` — Ashmolean Museum
# - `oum` — Oxford University Museum of Natural History
# - `prm` — Pitt Rivers Museum
# - `hsm` — History of Science Museum
# @required @public @type=enum(ash, oum, prm, hsm)
NEXT_PUBLIC_MUSEUM=

# Optional HTTP basic auth for preview/staging deployments. When both are set, all
# pages require a valid Authorization header. Username is validated here; set
# BASIC_AUTH_PASS on the deployment platform only (not in this schema) — varlock's
# build leak scan substring-matches SSR HTML, which false-positives on catalogue
# words like "italian" in item slugs.
# @optional @public
BASIC_AUTH_USER=
