# Env schema for collections-online, validated at boot by varlock — https://varlock.dev
# Set the actual value in `.env.local` (gitignored), e.g. `MUSEUM=hsm`
# ---

# Active GLAM Oxford museum site for this deployment:
# - `ash` — Ashmolean Museum
# - `oum` — Oxford University Museum of Natural History
# - `prm` — Pitt Rivers Museum
# - `hsm` — History of Science Museum
# @required @public @type=enum(ash, oum, prm, hsm)
MUSEUM=

# Optional HTTP basic auth for preview/staging deployments. When both are set, all
# pages require a valid Authorization header. Access via ENV in server/proxy code.
# Username is @public so short values like "preview" don't false-positive varlock's
# build leak scan (Next.js output already contains the word "preview").
# @optional @public
BASIC_AUTH_USER=

# Min length avoids varlock leak-scan false positives on short values (e.g. "bar"
# matches substrings inside minified Next.js client chunks like "subarray").
# @optional @sensitive @type=string(minLength=6)
BASIC_AUTH_PASS=
